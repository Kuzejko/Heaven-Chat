{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Heaven Chat",
  "version": "1.0.0",
  "identifier": "com.heavenchat.app",
  "build": {
    "frontendDist": "../www",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "node scripts/build-web.js"
  },
  "app": {
    "windows": [
      {
        "title": "Heaven Chat",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "proxyUrl": "http://127.0.0.1:10809"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
